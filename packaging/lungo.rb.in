# Generated by the workspace package publish — do not edit by hand.
class Lungo < Formula
  desc "Generate Rust, C, Go, Python, Swift and TypeScript from proved Lean programs"
  homepage "https://machinefabric.com/lungo"
  version "@{version}"

  on_macos do
    if Hardware::CPU.arm?
      @{platform_block:darwin-arm64}
    else
      @{platform_block:darwin-x86_64}
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      @{platform_block:linux-arm64}
    else
      @{platform_block:linux-x86_64}
    end
  end

  def install
    # The archive extracts to @{bundle_dir}/{@{package},LICENSE,README.md}.
    libexec.install Dir["@{bundle_dir}/*"]
    bin.install_symlink libexec/"@{package}"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/@{package} --version")
  end
end
