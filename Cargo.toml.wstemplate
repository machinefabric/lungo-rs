# Rendered from Cargo.toml.wstemplate by `wsb update`: edit the template, not Cargo.toml.

[workspace]
members = [
    "crates/cargo-patina",
    "crates/patina",
    "crates/patina-bir",
    "crates/patina-build",
    "crates/patina-codegen",
    "crates/patina-protocol",
    "crates/patina-runtime",
    "examples/session",
    "compiler-tests/runner",
    "compiler-tests/facade-runner",
    "compiler-tests/host",
    "compiler-tests/shaping",
    "compiler-tests/gates",
]
resolver = "3"

[workspace.package]
version = "{{ project.version }}"
edition = "2024"
rust-version = "1.89"
license = "Apache-2.0"
authors = ["Bahram Joharshamshiri <jowharshamshiri@gmail.com>"]
repository = "https://github.com/jowharshamshiri/patina"
homepage = "https://github.com/jowharshamshiri/patina"

[workspace.dependencies]
# The patina crates are released together and depend on each other's unstable internals (the
# generated code, the Bridge IR, the worker protocol), so they require each other's exact
# version.
patina = { path = "crates/patina", version = "={{ project.version }}" }
patina-bir = { path = "crates/patina-bir", version = "={{ project.version }}" }
patina-build = { path = "crates/patina-build", version = "={{ project.version }}" }
patina-codegen = { path = "crates/patina-codegen", version = "={{ project.version }}" }
patina-protocol = { path = "crates/patina-protocol", version = "={{ project.version }}" }
patina-runtime = { path = "crates/patina-runtime", version = "={{ project.version }}" }

ciborium = "0.2.2"
libc = "0.2"
num-bigint = "0.4"
num-traits = "0.2"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
toml = "0.8"
windows-sys = "0.59"
