prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib

Name: lungo
Description: The lungo runtime (@TARGET@), which lungo's generated programs link against
Version: @VERSION@
URL: https://github.com/jowharshamshiri/lungo
Cflags: -I${includedir}
Libs: -L${libdir} -llungo
Libs.private: @NATIVE_LIBRARIES_PC@
