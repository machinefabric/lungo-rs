# The lungo runtime is compatible only with generated code of exactly its version, for its
# target.
set(PACKAGE_VERSION "@VERSION@")
if(PACKAGE_FIND_VERSION AND NOT PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
elseif(NOT CMAKE_SIZEOF_VOID_P STREQUAL "@POINTER_BYTES@")
  set(PACKAGE_VERSION "${PACKAGE_VERSION} (@TARGET@, @POINTER_BYTES@-byte pointers)")
  set(PACKAGE_VERSION_UNSUITABLE TRUE)
else()
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
endif()
